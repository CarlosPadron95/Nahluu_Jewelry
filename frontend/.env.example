# ------------------------------------------------------------------
# Plantilla de variables de entorno del FRONTEND
#
# 1. Copia este archivo y llámalo .env.local (en esta misma carpeta)
# 2. Rellena los valores
# 3. NUNCA subas .env.local a GitHub (ya está en .gitignore)
#
# Ojo: lo que empieza por NEXT_PUBLIC_ lo puede ver cualquiera en el
# navegador. Nunca pongas una clave secreta en una variable NEXT_PUBLIC_.
# ------------------------------------------------------------------

# Dirección de la API de Django
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Dirección pública de la web (para enlaces, SEO y redes sociales)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
