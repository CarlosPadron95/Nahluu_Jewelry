# ------------------------------------------------------------------
# Plantilla de variables de entorno del BACKEND
#
# 1. Copia este archivo y llámalo .env (en esta misma carpeta)
# 2. Rellena los valores
# 3. NUNCA subas el archivo .env a GitHub (ya está en .gitignore)
# ------------------------------------------------------------------

# Clave secreta de Django. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# (solo letras, números, - y _: así no hay símbolos raros que rompan el .env)
DJANGO_SECRET_KEY=

# En local true; en producción no se pone (por defecto es false)
DJANGO_DEBUG=true

# Dominios permitidos, separados por comas
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Ruta del panel de administración (tiene que terminar en /)
# En producción usa algo difícil de adivinar, por ejemplo: gestion-7f3k2/
DJANGO_ADMIN_URL=admin/

# Base de datos (la de docker-compose.yml en local)
# Usamos 127.0.0.1 y no "localhost": en Windows, "localhost" puede ir primero
# por IPv6 y la conexión se queda colgada
DATABASE_URL=postgres://nahluu:nahluu_local@127.0.0.1:5432/nahluu

# Webs que pueden llamar a la API (el frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Fotos en Cloudinary (opcional en local, obligatorio en producción).
# Vacío = las fotos se guardan en backend/media/
# Cópiala de Cloudinary: Settings → API Keys → "API environment variable"
# Tiene esta forma: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Carpeta de Cloudinary para este entorno (en producción: nahluu)
CLOUDINARY_FOLDER=nahluu-local
